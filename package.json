{
  "name": "tether",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "oxlint --config oxlint.config.ts",
    "lint:fix": "oxlint --fix --config oxlint.config.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "bun run test:unit",
    "test:unit": "turbo test --filter='!e2e'",
    "test:e2e": "turbo test --filter=e2e",
    "test:all": "bun run test:unit && bun run test:e2e",
    "test:coverage": "turbo test:coverage",
    "test:watch": "turbo test:watch --filter='!e2e'",
    "prepare": "effect-language-service patch"
  },
  "dependencies": {
    "@effect/language-service": "0.87.0",
    "@types/bun": "catalog:",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "oxlint-tsgolint": "^7.0.2001",
    "turbo": "^2.10.6",
    "typescript": "catalog:"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "packageManager": "bun@1.3.14",
  "catalog": {
    "@effect/platform-bun": "4.0.0-beta.101",
    "@effect/atom-react": "4.0.0-beta.101",
    "@effect/vitest": "4.0.0-beta.101",
    "@react-three/drei": "11.0.0-alpha.5",
    "@react-three/fiber": "10.0.0-alpha.2",
    "@vitest/coverage-v8": "^4.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/devtools-vite": "^0.8.3",
    "@tanstack/react-hotkeys": "0.10.0",
    "@tanstack/router-plugin": "^1.168.23",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "effect": "4.0.0-beta.101",
    "lucide-react": "^1.25.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "@rolldown/plugin-babel": "^0.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "typescript": "^6.0.3",
    "three": "0.185.1",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "trustedDependencies": [
    "electron"
  ]
}
