{
  "name": "tether",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "oxlint --config oxlint.config.ts",
    "lint:fix": "oxlint --fix --config oxlint.config.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "turbo test",
    "test:watch": "turbo test:watch",
    "prepare": "effect-language-service patch"
  },
  "dependencies": {
    "@effect/language-service": "^0.86.2",
    "@types/bun": "catalog:",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "oxlint-tsgolint": "^0.24.0",
    "turbo": "^2.10.2",
    "typescript": "catalog:"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "packageManager": "bun@1.3.14",
  "catalog": {
    "@effect/platform-bun": "^4.0.0-beta.93",
    "@effect/atom-react": "^4.0.0-beta.93",
    "@effect/vitest": "^4.0.0-beta.93",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/devtools-vite": "^0.8.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "effect": "^4.0.0-beta.93",
    "lucide-react": "^1.23.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
