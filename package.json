{
  "name": "turborepo-effect-starter",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "oxlint --config oxlint.config.ts",
    "lint:fix": "oxlint --fix --config oxlint.config.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepare": "effect-language-service patch"
  },
  "dependencies": {
    "@effect/language-service": "^0.86.2",
    "@types/bun": "catalog:",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.67.0",
    "oxlint-tsgolint": "^0.23.0",
    "turbo": "^2.9.16",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.14",
  "catalog": {
    "@effect/atom-react": "^4.0.0-beta.83",
    "@effect/platform-bun": "^4.0.0-beta.83",
    "@effect/sql-pg": "^4.0.0-beta.83",
    "@tailwindcss/vite": "^4.3.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "effect": "^4.0.0-beta.83",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^6.0.3"
  }
}
