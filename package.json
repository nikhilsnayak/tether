{
  "name": "tether",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "oxlint --config oxlint.config.ts",
    "lint:fix": "oxlint --fix --config oxlint.config.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "turbo test",
    "test:integration": "turbo test:integration",
    "test:watch": "turbo test:watch",
    "prepare": "effect-language-service patch"
  },
  "dependencies": {
    "@effect/language-service": "^0.86.2",
    "@types/bun": "catalog:",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.71.0",
    "oxlint-tsgolint": "^0.23.0",
    "turbo": "^2.10.0",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.14",
  "catalog": {
    "@effect/platform-bun": "^4.0.0-beta.91",
    "@effect/vitest": "^4.0.0-beta.91",
    "@tailwindcss/vite": "^4.3.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "effect": "^4.0.0-beta.91",
    "lucide-react": "^1.21.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
