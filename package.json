{
  "name": "tether",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "oxlint --config oxlint.config.ts",
    "lint:fix": "oxlint --fix --config oxlint.config.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "bun run test:unit",
    "test:unit": "turbo test --filter='!e2e'",
    "test:e2e": "turbo test --filter=e2e",
    "test:e2e:fast": "turbo test:fast --filter=e2e",
    "test:e2e:gpu": "turbo test:gpu --filter=e2e",
    "test:e2e:real-render:smoke": "bun run --cwd e2e test:real-render:smoke",
    "test:all": "bun run test:unit && bun run test:e2e",
    "test:coverage": "turbo test:coverage",
    "test:watch": "turbo test:watch --filter='!e2e'",
    "prepare": "effect-language-service patch"
  },
  "dependencies": {
    "@effect/language-service": "0.86.4",
    "@types/bun": "catalog:",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "oxlint-tsgolint": "^0.24.0",
    "turbo": "^2.10.5",
    "typescript": "catalog:"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "packageManager": "bun@1.3.14",
  "catalog": {
    "@effect/platform-bun": "4.0.0-beta.97",
    "@effect/atom-react": "4.0.0-beta.97",
    "@effect/vitest": "4.0.0-beta.97",
    "@react-three/drei": "11.0.0-alpha.5",
    "@react-three/fiber": "10.0.0-alpha.2",
    "@vitest/coverage-v8": "^4.1.10",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/devtools-vite": "^0.8.1",
    "@tanstack/react-hotkeys": "0.10.0",
    "@tanstack/router-plugin": "^1.168.19",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "effect": "4.0.0-beta.97",
    "lucide-react": "^1.24.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "@rolldown/plugin-babel": "^0.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "typescript": "^6.0.3",
    "three": "0.185.1",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "trustedDependencies": [
    "electron"
  ]
}
