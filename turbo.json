{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {},
    "e2e#test": {
      "env": ["CI"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/server/package.json",
        "$TURBO_ROOT$/apps/server/src/**",
        "$TURBO_ROOT$/apps/server/tsconfig.json",
        "$TURBO_ROOT$/apps/web/index.html",
        "$TURBO_ROOT$/apps/web/package.json",
        "$TURBO_ROOT$/apps/web/public/**",
        "$TURBO_ROOT$/apps/web/src/**",
        "$TURBO_ROOT$/apps/web/tsconfig*.json",
        "$TURBO_ROOT$/apps/web/vite.config.ts",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/packages/*/tsconfig*.json"
      ],
      "outputs": ["playwright-report/**", "test-results/**"]
    },
    "test:coverage": {
      "outputs": ["coverage/**"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "//#lint": {},
    "//#lint:fix": {
      "cache": false
    },
    "//#fmt": {
      "cache": false
    },
    "//#fmt:check": {},
    "//#check": {
      "dependsOn": ["//#lint", "//#fmt:check"]
    },
    "//#fix": {
      "dependsOn": ["//#lint:fix", "//#fmt"]
    }
  }
}
